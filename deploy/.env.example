# Copy to .env and fill in. Never commit the real .env.

# Where people reach MegooColab. A domain gets automatic HTTPS from Caddy; ":80" = plain HTTP.
SITE_ADDRESS=:80
# Host ports Caddy listens on.
HTTP_PORT=80
HTTPS_PORT=443
# The full URL users open (used in invite and reset links).
PUBLIC_URL=http://localhost
# true when served over HTTPS.
COOKIE_SECURE=false

# Generate with: openssl rand -hex 32   (the backend refuses to start with this example value)
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
POSTGRES_PASSWORD=change-this-database-password

# Tests only: local fake embeddings, no AI provider calls. Never set in production.
# AI_FAKE=true
