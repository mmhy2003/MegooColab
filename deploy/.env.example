# Copy to .env and fill in. Never commit the real .env.

# Where people reach MegooColab. A domain gets automatic HTTPS from Caddy; ":80" = plain HTTP.
SITE_ADDRESS=:80
# Host ports Caddy listens on (change HTTP_PORT when another proxy in front terminates TLS).
HTTP_PORT=80
HTTPS_PORT=443
# The full URL users open, no trailing slash (used in invitation, reset and notification links).
PUBLIC_URL=http://localhost
# true when served over HTTPS: session cookies are then sent over HTTPS only.
COOKIE_SECURE=false

# Signs sessions and encrypts stored secrets (SMTP password, AI keys, git tokens). Generate once with
# `openssl rand -hex 32` (the backend refuses to start with this example value) and keep it: a new key makes
# the stored secrets unreadable.
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
# The database password, used only between the containers. Set it before the first start: the database keeps
# the first one.
POSTGRES_PASSWORD=change-this-database-password

# Required: the key the backend and worker use for Meilisearch (global search). Generate it with:
#   openssl rand -hex 32
MEILI_MASTER_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# The hour (0-23, UTC) the memory dreams each night, unless an admin sets one under Admin -> Settings.
MEMORY_DREAM_HOUR_UTC=3

# Tests only: local fake embeddings, no AI provider calls. Never set in production.
# AI_FAKE=true
# Tests only: read changed memory sources after 2 s instead of 60 s.
# MEMORY_EXTRACT_DELAY_SECONDS=2
