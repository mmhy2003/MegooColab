# Copy to .env and fill in. Never commit the real .env.

# Where people reach MegooColab. A domain gets automatic HTTPS from Caddy; ":80" = plain HTTP.
SITE_ADDRESS=:80
# Host ports Caddy listens on (change HTTP_PORT when another proxy in front terminates TLS).
HTTP_PORT=80
HTTPS_PORT=443
# The full URL users open, no trailing slash (used in invitation, reset and notification links).
PUBLIC_URL=http://localhost
# true when served over HTTPS: session cookies are then sent over HTTPS only.
COOKIE_SECURE=false

# Signs sessions and encrypts stored secrets (SMTP password, AI keys, git tokens). Generate once with
# `openssl rand -hex 32` (the backend refuses to start with this example value) and keep it: a new key makes
# the stored secrets unreadable.
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
# The database password, used only between the containers. Set it before the first start: the database keeps
# the first one. Any characters work.
POSTGRES_PASSWORD=change-this-database-password

# Required: the key the backend and worker use for Meilisearch (global search). Generate it with:
#   openssl rand -hex 32
MEILI_MASTER_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# Required: the password of Valkey, which keeps the rate-limit counters. Generate it with:
#   openssl rand -hex 32
VALKEY_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32

# Only when a proxy in front of MegooColab (a Cloudflare tunnel, ...) hides visitors' addresses: the header it
# sets with the real address. Set it only if every request comes through that proxy (docs/install.md).
# CLIENT_IP_HEADER=CF-Connecting-IP

# Rate limits (defaults shown). Failed sign-ins per address per 15 min; wrong two-factor codes per account per
# 15 min; forgot-password emails per address per hour and requests per IP per hour; failed reset, invite and
# setup links per IP per hour; wrong current passwords per user per 15 min; API calls per minute per signed-in
# browser or token, and per IP when not signed in; AI calls per minute; webhook deliveries per minute per git
# connection; live-connection openings per minute. 0 turns a limit off.
# RATE_LIMIT_LOGIN_PER_IP=30
# RATE_LIMIT_TOTP_PER_ACCOUNT=5
# RATE_LIMIT_FORGOT_PER_EMAIL=3
# RATE_LIMIT_FORGOT_PER_IP=10
# RATE_LIMIT_TOKEN_PAGES_PER_IP=10
# RATE_LIMIT_CHANGE_PASSWORD_PER_USER=5
# RATE_LIMIT_API_PER_USER=3000
# RATE_LIMIT_API_PER_IP=120
# RATE_LIMIT_AI_PER_USER=30
# RATE_LIMIT_WEBHOOK_PER_CONNECTION=120
# RATE_LIMIT_WS_CONNECT=30

# The worker asks GitHub every 6 hours for the latest MegooColab and runner versions, so the app can say when
# an update is out. false turns that off (no internet, or no calls to GitHub wanted); no update notices then.
# UPDATE_CHECK=false

# The MegooColab version to run (the image tag). Unset: the latest release, which `docker compose pull` fetches.
# Pin one to stay on it until you change it:
# MEGOO_VERSION=0.1.0

# Coloured log levels in `docker compose logs` (and log viewers that show colour). Off by default: a log file
# would get the escape codes as text.
# FORCE_COLOR=1

# The hour (0-23, UTC) the memory dreams each night, unless an admin sets one under Admin -> Settings.
MEMORY_DREAM_HOUR_UTC=3

# Tests only: local fake embeddings, no AI provider calls. Never set in production.
# AI_FAKE=true
# Tests only: read changed memory sources after 2 s instead of 60 s.
# MEMORY_EXTRACT_DELAY_SECONDS=2
